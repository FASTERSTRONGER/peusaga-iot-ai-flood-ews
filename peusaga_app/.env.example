# Konfigurasi Server Flask PEUSAGA
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=ganti-dengan-kunci-rahasia-produksi-peusaga
PORT=5000
TZ=Asia/Jakarta

# Konfigurasi Database MySQL 8.0
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/peusaga_db?charset=utf8mb4

# Kunci API Node IoT LoRa (Pisahkan dengan koma jika lebih dari satu)
GATEWAY_DEFAULT_KEY=KEY_PEUSANGAN_GATEWAY_915
HULU_NODE_KEY=KEY_PEUSANGAN_HULU_915
HILIR_NODE_KEY=KEY_PEUSANGAN_HILIR_915

# Diseminasi Peringatan Dini (Opsional - Webhook WhatsApp / Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_API_TOKEN=
WEBHOOK_DRY_RUN=true
